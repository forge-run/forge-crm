{
  "name": "contacts",
  "archetype": "Record",
  "label": "Contact",
  "description": "A person at an account — the human you actually talk to.",
  "api": {
    "access": "read_write",
    "filterable": ["account_id", "owner_id", "status", "created_at"],
    "sortable": ["last_name", "first_name", "created_at"],
    "default_sort": "created_at",
    "default_sort_dir": "desc"
  },
  "columns": [
    { "name": "tenant_id", "type": "string", "format": "uuid", "required": true, "label": "Tenant" },
    { "name": "owner_id", "type": "string", "format": "uuid", "required": false, "label": "Owner" },
    { "name": "account_id", "type": "string", "format": "uuid", "required": false, "references": { "table": "accounts", "column": "id", "on_delete": "set_null" }, "label": "Account" },
    { "name": "first_name", "type": "string", "required": true, "maxLength": 120, "label": "First name" },
    { "name": "last_name", "type": "string", "required": false, "maxLength": 120, "label": "Last name" },
    { "name": "email", "type": "string", "required": false, "maxLength": 320, "format": "email", "pii": true, "label": "Email" },
    { "name": "phone", "type": "string", "required": false, "maxLength": 40, "pii": true, "label": "Phone" },
    { "name": "title", "type": "string", "required": false, "maxLength": 160, "label": "Job title" },
    { "name": "department", "type": "string", "required": false, "maxLength": 120, "label": "Department" },
    { "name": "status", "type": "string", "required": false, "enum": ["active", "inactive"], "default": "active", "label": "Status" }
  ],
  "indexes": [
    { "columns": ["tenant_id", "account_id"] },
    { "columns": ["tenant_id", "last_name"] }
  ],
  "row_security": [
    {
      "name": "tenant_isolation",
      "filter": { "column": "tenant_id", "op": "eq", "value": "$claims.tenant_id" },
      "scopes": ["select", "insert", "update", "delete"]
    }
  ]
}
