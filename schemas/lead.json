{
  "name": "leads",
  "archetype": "Record",
  "label": "Lead",
  "description": "An unqualified prospect — the top of the funnel, before they're worth an account + opportunity. Convert a qualified lead into a contact and a deal.",
  "api": {
    "access": "read_write",
    "filterable": ["status", "source", "rating", "owner_id", "converted", "created_at"],
    "sortable": ["created_at", "last_name", "rating"],
    "default_sort": "created_at",
    "default_sort_dir": "desc"
  },
  "columns": [
    { "name": "tenant_id", "type": "string", "format": "uuid", "required": true, "label": "Tenant" },
    { "name": "owner_id", "type": "string", "format": "uuid", "required": false, "label": "Owner" },
    { "name": "first_name", "type": "string", "required": true, "maxLength": 120, "label": "First name" },
    { "name": "last_name", "type": "string", "required": false, "maxLength": 120, "label": "Last name" },
    { "name": "email", "type": "string", "required": false, "maxLength": 320, "format": "email", "pii": true, "label": "Email" },
    { "name": "phone", "type": "string", "required": false, "maxLength": 40, "pii": true, "label": "Phone" },
    { "name": "company", "type": "string", "required": false, "maxLength": 200, "label": "Company" },
    { "name": "title", "type": "string", "required": false, "maxLength": 160, "label": "Job title" },
    { "name": "status", "type": "string", "required": false, "enum": ["new", "working", "qualified", "unqualified"], "default": "new", "label": "Status" },
    { "name": "source", "type": "string", "required": false, "enum": ["web", "referral", "event", "outbound", "partner", "other"], "label": "Source" },
    { "name": "rating", "type": "string", "required": false, "enum": ["hot", "warm", "cold"], "label": "Rating" },
    { "name": "converted", "type": "boolean", "required": false, "default": false, "label": "Converted" },
    { "name": "converted_contact_id", "type": "string", "format": "uuid", "required": false, "references": { "table": "contacts", "column": "id", "on_delete": "set_null" }, "label": "Converted contact" }
  ],
  "indexes": [
    { "columns": ["tenant_id", "status"] },
    { "columns": ["tenant_id", "owner_id"] }
  ],
  "row_security": [
    {
      "name": "tenant_isolation",
      "filter": { "column": "tenant_id", "op": "eq", "value": "$claims.tenant_id" },
      "scopes": ["select", "insert", "update", "delete"]
    }
  ]
}
