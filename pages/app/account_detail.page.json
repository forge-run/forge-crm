{
  "schema_version": "0.1",
  "name": "account_detail",
  "route": {
    "method": "GET",
    "path": "/app/accounts/:id"
  },
  "auth": "Authenticated",
  "surface": [
    "app"
  ],
  "rendering": "BufferedHtml",
  "data": {
    "rec": {
      "query": "@op:crm::get_account",
      "params": {
        "id": "$path:id"
      },
      "default": {
        "account": null,
        "contacts": [],
        "opportunities": [],
        "activities": []
      }
    }
  },
  "template": {
    "kind": "Path",
    "path": "pages/app/account_detail.page.html"
  },
  "title": "Account \u2014 Forge CRM"
}
